# Example reverse proxy for production ULMS + Koha paths.
# Replace certificate paths and upstream hosts for the university environment.

upstream libraryhub_web {
    server 127.0.0.1:3000;
}

upstream libraryhub_api {
    server 127.0.0.1:8000;
}

server {
    listen 443 ssl http2;
    server_name libraryhub.example.edu;

    ssl_certificate     /etc/ssl/certs/libraryhub.crt;
    ssl_certificate_key /etc/ssl/private/libraryhub.key;

    location /api/ {
        proxy_pass http://libraryhub_api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://libraryhub_web;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}