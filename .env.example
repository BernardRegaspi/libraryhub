# Copy to .env in the repository root and fill in values. Do not commit .env.

APP_ENV=development
LOG_LEVEL=INFO

# ULMS PostgreSQL (local docker compose defaults)
DATABASE_URL=postgresql+psycopg://libraryhub:libraryhub_dev@localhost:5432/libraryhub

# Optional local Redis (docker compose)
REDIS_URL=redis://localhost:6379/0

# Koha REST API (backend only — never expose in NEXT_PUBLIC_*)
KOHA_BASE_URL=
KOHA_API_USERNAME=
KOHA_API_PASSWORD=

# Next.js (browser calls FastAPI only)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1